# Copy this file per environment (e.g. .env.dev, .env.qs, .env.prod) and fill in
# the real values. Select the right one at deploy time:
#   podman compose --env-file .env.prod up -d --build
# A plain ".env" in this directory is picked up automatically if no --env-file is given.

ADMIN_USERNAME=sa
ADMIN_PASSWORD=change-me

# Brand/theme color for the UI (build-time, see src/TsiBroker.Ui/.env.example).
VITE_THEME_COLOR=#a2bd30
