# Base URL of the API (leave empty to use the same origin).
VITE_API_BASE_URL=

# Brand/theme color (any valid CSS color). Overrides the default violet.
# Set a different value per environment, e.g. in .env.development / .env.qs / .env.production,
# so dev, qs and prod are visually distinguishable at a glance.
VITE_THEME_COLOR="#6f4295"

# Default UI language when no language cookie is set yet (one of: de, en).
# Leave empty to fall back to English.
VITE_DEFAULT_LOCALE="de"
